{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortfolioDataSchema",
  "type": "object",
  "required": ["profile", "artworks", "showcaseComparison", "commissionTiers"],
  "properties": {
    "profile": {
      "type": "object",
      "required": ["name", "handle", "title", "subtitle", "status", "statusText", "discordTag", "email", "bio", "socials"],
      "properties": {
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "WAITLIST", "CLOSED"] },
        "statusText": { "type": "string" },
        "discordTag": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "bio": { "type": "string" },
        "socials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "label", "url"],
            "properties": {
              "platform": { "type": "string" },
              "label": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "artworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "description", "date", "tags", "thumbnailUrl", "fullUrl", "aspectRatio"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string", "enum": ["Character Design", "Comic Adaptations", "Illustrations"] },
          "description": { "type": "string" },
          "date": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "thumbnailUrl": { "type": "string" },
          "fullUrl": { "type": "string" },
          "aspectRatio": { "type": "string", "enum": ["1/1", "4/5", "16/9", "3/4"] },
          "featured": { "type": "boolean" }
        }
      }
    },
    "showcaseComparison": {
      "type": "object",
      "required": ["id", "title", "subtitle", "sketchImage", "sketchLabel", "renderImage", "renderLabel", "description"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "sketchImage": { "type": "string" },
        "sketchLabel": { "type": "string" },
        "renderImage": { "type": "string" },
        "renderLabel": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "commissionTiers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "subtitle", "price", "currency", "turnaroundTime", "deliverables", "commercialUsage"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "subtitle": { "type": "string" },
          "price": { "type": "number", "minimum": 0 },
          "currency": { "type": "string" },
          "turnaroundTime": { "type": "string" },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "commercialUsage": { "type": "boolean" },
          "popular": { "type": "boolean" }
        }
      }
    }
  }
}
